		{
			"name": "get csrf token",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Leer respuesta JSON\r",
							"const res = pm.response.json();\r",
							"\r",
							"// Guardar token en variable de entorno\r",
							"pm.environment.set(\"csrfToken\", res.token);\r",
							"\r",
							"// Crear cookie manualmente en localhost\r",
							"pm.cookies.jar().set(\"http://localhost:3001\", \"__Host-csrf-token\", res.token, function (error) {\r",
							"    if (error) {\r",
							"        console.error(\"Error al crear cookie CSRF:\", error);\r",
							"    } else {\r",
							"        console.log(\"✅ Cookie csrf-token creada correctamente en localhost:3001\");\r",
							"    }\r",
							"});\r",
							"\r",
							"console.log(\"CSRF token guardado:\", res.token);\r",
							""
						],
