{
  "name": "back-node",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "start": "node ./dist/main.js",
    "build": "tsc -p tsconfig.json",
    "dev": "node -r dotenv/config -r ts-node/register ./src/main.ts",
    "typeorm": "node ./node_modules/typeorm/cli.js -d /app/dist/infrastructure/persistence/typeorm/data-source.js",
    "migration:run": "npm run typeorm migration:run",
    "migration:revert": "npm run typeorm migration:revert",
    "typeorm:local": "node -r dotenv/config -r ts-node/register ./node_modules/typeorm/cli.js -d src/infrastructure/persistence/typeorm/data-source.ts",
    "migration:local:run": "npm run typeorm:local -- migration:run",
    "migration:local:revert": "npm run typeorm:local -- migration:revert",
    "test:coverage": "jest --coverage --passWithNoTests",
    "test": "jest --passWithNoTests",
    "test:unit": "jest --runTestsByPath ./test/unit",
    "test:integration": "jest --runTestsByPath ./test/integration",
    "test:e2e": "jest --runTestsByPath ./test/e2e --detectOpenHandles"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "dependencies": {
    "@automapper/classes": "8.5.0",
    "@automapper/core": "8.5.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.3.0",
    "helmet": "^8.1.0",
    "inversify": "^7.10.3",
    "mysql2": "^3.15.3",
    "reflect-metadata": "0.2.2",
    "typeorm": "^0.3.27",
    "uuid": "^9.0.0",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.2.3",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.1",
    "better-sqlite3": "^12.4.1",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.2"
  }
}
